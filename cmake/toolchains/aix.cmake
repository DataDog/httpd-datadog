set(CMAKE_SYSTEM_NAME AIX)
set(CMAKE_SYSTEM_VERSION 7.3)
set(CMAKE_SYSTEM_PROCESSOR ppc64)

set(AIX_TOOLCHAIN_ROOT "$ENV{AIX_TOOLCHAIN_ROOT}" CACHE PATH "AIX compiler and sysroot")
set(AIX_CXX_ROOT "$ENV{AIX_CXX_ROOT}" CACHE PATH "Threaded AIX 7.2 C++ runtime")
if(NOT EXISTS "${AIX_TOOLCHAIN_ROOT}/sysroot/usr/include")
  message(FATAL_ERROR "Set AIX_TOOLCHAIN_ROOT to the extracted Datadog toolchain")
endif()
set(AIX_TRIPLE powerpc-ibm-aix7.3.0.0 CACHE STRING "Compiler target triplet")
set(CMAKE_C_COMPILER "${AIX_TOOLCHAIN_ROOT}/compiler/bin/${AIX_TRIPLE}-gcc")
set(CMAKE_CXX_COMPILER "${AIX_TOOLCHAIN_ROOT}/compiler/bin/${AIX_TRIPLE}-g++")
set(CMAKE_AR "${AIX_TOOLCHAIN_ROOT}/compiler/bin/${AIX_TRIPLE}-ar")
set(CMAKE_RANLIB "${AIX_TOOLCHAIN_ROOT}/compiler/bin/${AIX_TRIPLE}-ranlib")
set(CMAKE_NM "${AIX_TOOLCHAIN_ROOT}/compiler/bin/${AIX_TRIPLE}-nm")
set(CMAKE_SYSROOT "${AIX_TOOLCHAIN_ROOT}/sysroot")
set(CMAKE_SKIP_RPATH TRUE)
set(CMAKE_C_FLAGS_INIT "-maix64 -mcpu=powerpc64 -pthread -D_ALL_SOURCE")
set(CMAKE_CXX_FLAGS_INIT "-maix64 -mcpu=powerpc64 -pthread -D_ALL_SOURCE")
if(AIX_CXX_ROOT)
  set(AIX_CXX_PLATFORM "${AIX_CXX_ROOT}/include/powerpc-ibm-aix7.2.0.0")
  string(APPEND CMAKE_CXX_FLAGS_INIT
    " -nostdinc++ -isystem ${AIX_CXX_ROOT}/include -isystem ${AIX_CXX_PLATFORM}/pthread/ppc64 -isystem ${AIX_CXX_PLATFORM}")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${AIX_CXX_ROOT}/lib")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "-L${AIX_CXX_ROOT}/lib")
endif()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AIX_TOOLCHAIN_ROOT AIX_TRIPLE AIX_CXX_ROOT)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/aix-gnu-rules.cmake")
